	url = {https://onlinelibrary.wiley.com/doi/abs/10.1029/2006GL027734},
	doi = {10.1029/2006GL027734},
	abstract = {To make progress in understanding the distribution and genesis of coral mounds in cold and dark water, maps of morphology and oceanographic conditions resolving features at the 1–10 m scale are needed. An autonomous underwater vehicle (AUV) cruising 40 m above the seafloor surveyed a 48 km2 coral mound field in 600–800 m water depth at the base of slope of Great Bahama Bank. The AUV acquired 1–3 meter resolution acoustic backscatter and bathymetry together with current vectors, salinity, and temperature. The multibeam bathymetry resolved more than 200 coral mounds reaching up to 90 m height. Mound morphology is surprisingly diverse and mound distribution follows E-W oriented off-bank ridges. Bottom currents reverse every 6 hours indicating tidal flow decoupled from the north flowing surface current. The AUV data fill the gap between low-resolution surface-based mapping and visual observations on the seafloor, revealing the dynamic environment and spatial relationships of an entire coral mound field.},
	language = {en},
	number = {23},
	urldate = {2026-03-22},
	journal = {Geophysical Research Letters},
	author = {Grasmueck, Mark and Eberli, Gregor P. and Viggiano, David A. and Correa, Thiago and Rathwell, Glenda and Luo, Jiangang},
	year = {2006},
	note = {\_eprint: https://agupubs.onlinelibrary.wiley.com/doi/pdf/10.1029/2006GL027734},
	keywords = {autonomous underwater vehicle, cold water corals, multibeam solar mapping},
	file = {Full Text PDF:/Users/savannasaunders/Zotero/storage/GDQFZYFY/Grasmueck et al. - 2006 - Autonomous underwater vehicle (AUV) mapping reveals coral mound distribution, morphology, and oceano.pdf:application/pdf;Snapshot:/Users/savannasaunders/Zotero/storage/VQ9QC4G8/2006GL027734.html:text/html},
}

@article{sattar_sensor-based_2009,
	title = {Sensor-{Based} {Behavior} {Control} for an {Autonomous} {Underwater} {Vehicle}},
	abstract = {In this paper, we evaluate a set of core functions that allow an underwater robot to perform surveillance under operator control. Speciﬁcally, we are interested in behaviors that facilitate the monitoring of organisms on a coral reef, and we present behaviors and interaction modes for a small underwater robot. In particular, we address some challenging issues arising from the underwater environment: visual processing, interactive communication with an underwater crew, and ﬁnally orientation and motion of the vehicle through a hovering mode. The visual processing consists of target tracking using various techniques (color segmentation, color histogram and mean shift). Communication underwater is achieved through printed cards with robustly identiﬁable visual markers on them. Finally, the hovering gait developed for this vehicle relies on the planned motion of six ﬂippers to generate the appropriate forces.},
	language = {en},
	author = {Sattar, Junaed and Giguere, Philippe and Dudek, Gregory},
	year = {2009},
	file = {PDF:/Users/savannasaunders/Zotero/storage/JJ5MFYN6/Sattar et al. - Sensor-Based Behavior Control for an Autonomous Underwater Vehicle.pdf:application/pdf},
}

@article{kalwa_european_2016,
	title = {The {European} {Project} {MORPH}: {Distributed} {UUV} {Systems} for {Multimodal}, {3D} {Underwater} {Surveys}},
	volume = {50},
	issn = {0025-3324},
	shorttitle = {The {European} {Project} {MORPH}},
	url = {https://www.ingentaconnect.com/content/10.4031/MTSJ.50.4.10},
	doi = {10.4031/MTSJ.50.4.10},
	abstract = {The MORPH project (FP 7, 2012–2016) is aimed at developing efﬁcient methods and tools to map the underwater environment in situations that are not easily addressed by current technology. Namely, the missions that are of interest are those that involve underwater surveying and marine habitat mapping of rugged terrain and structures with full 3D complexity, including vertical cliffs. Potential applications include the study of cold water coral reef communities, ecosystems from underwater canyons, pipeline and harbor monitoring, or the inspection of wind turbine foundations. The project introduced and advanced a novel concept of an underwater robotic system composed of a number of mobile robot modules (nodes), carrying complementary sensors for perception of the environment. Instead of being physically coupled, the modules are connected via communication links that allow a ﬂow of essential information among them. Without rigid links, the so-called MORPH Supra-Vehicle can reconﬁgure itself and adapt according to the environment and mission goals, responding, for example, to the shape of the terrain, including vertical walls. The ﬂexibility allows for more optimal positioning of each sensor, increased number of simultaneous viewpoints, and generally high-resolution data collection.},
	language = {en},
	number = {4},
	urldate = {2026-03-22},
	journal = {Marine Technology Society Journal},
	author = {Kalwa, Joerg and Tietjen, Daniel and Carreiro-Silva, Marina and Fontes, Jorge and Brignone, Lorenzo and Gracias, Nuno and Ridao, Pere and Pfingsthorn, Max and Birk, Andreas and Glotzbach, Thomas and Eckstein, Sebastian and Caccia, Massimo and Alves, João and Furfaro, Thomas and Ribeiro, Jorge and Pascoal, Antonio},
	month = jul,
	year = {2016},
	pages = {26--41},
	file = {PDF:/Users/savannasaunders/Zotero/storage/7CPT384Y/Kalwa et al. - 2016 - The European Project MORPH Distributed UUV Systems for Multimodal, 3D Underwater Surveys.pdf:application/pdf},
}

@inproceedings{murad_surveillance_2016,
